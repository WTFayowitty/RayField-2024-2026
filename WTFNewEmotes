local tweenService = game:GetService("TweenService")
local userInputService = game:GetService("UserInputService")
local players = game:GetService("Players")
local localPlayer = players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui")
local hasEnteredNewEmoteKey = localPlayer:FindFirstChild("HasEnteredNewEmoteKey")

if not hasEnteredNewEmoteKey then
  hasEnteredNewEmoteKey = Instance.new("BoolValue")
  hasEnteredNewEmoteKey.Name = "HasEnteredNewEmoteKey"
  hasEnteredNewEmoteKey.Value = false
  hasEnteredNewEmoteKey.Parent = localPlayer
end

local function f1()
  loadstring(game:HttpGet("https://raw.githubusercontent.com/WTFayowitty/RayField-2024-2026/refs/heads/main/WTFNewEmotes"))()
end

local function f2()
  local newEmotesKeyUI = Instance.new("ScreenGui")
  newEmotesKeyUI.Name = "NewEmotesKeyUI"
  newEmotesKeyUI.ResetOnSpawn = false
  newEmotesKeyUI.IgnoreGuiInset = true
  newEmotesKeyUI.Parent = playerGui

  local frame = Instance.new("Frame")
  frame.Size = UDim2.new(0, 360, 0, 210)
  frame.Position = UDim2.new(0.5, -180, 0.5, -105)
  frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
  frame.BorderSizePixel = 0
  frame.AnchorPoint = Vector2.new(0.5, 0.5)
  frame.ClipsDescendants = true
  frame.Parent = newEmotesKeyUI

  local uiCorner = Instance.new("UICorner")
  uiCorner.CornerRadius = UDim.new(0, 12)
  uiCorner.Parent = frame

  local imageLabel = Instance.new("ImageLabel")
  imageLabel.Image = "rbxassetid://1316045217"
  imageLabel.ImageColor3 = Color3.fromRGB(0, 0, 0)
  imageLabel.ImageTransparency = 0.6
  imageLabel.ScaleType = Enum.ScaleType.Slice
  imageLabel.SliceCenter = Rect.new(10, 10, 118, 118)
  imageLabel.Size = UDim2.new(1, 40, 1, 40)
  imageLabel.Position = UDim2.new(0, -20, 0, -20)
  imageLabel.BackgroundTransparency = 1
  imageLabel.ZIndex = 0
  imageLabel.Parent = frame

  local textLabel = Instance.new("TextLabel")
  textLabel.Text = "🎭 New Emotes - Access Key"
  textLabel.Font = Enum.Font.GothamBold
  textLabel.TextSize = 18
  textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
  textLabel.BackgroundTransparency = 1
  textLabel.Position = UDim2.new(0, 15, 0, 15)
  textLabel.Size = UDim2.new(1, -30, 0, 25)
  textLabel.TextXAlignment = Enum.TextXAlignment.Left
  textLabel.Parent = frame

  local textLabel2 = Instance.new("TextLabel")
  textLabel2.Text = "Enter your access key to continue"
  textLabel2.Font = Enum.Font.Gotham
  textLabel2.TextSize = 14
  textLabel2.TextColor3 = Color3.fromRGB(200, 200, 200)
  textLabel2.BackgroundTransparency = 1
  textLabel2.Position = UDim2.new(0, 15, 0, 40)
  textLabel2.Size = UDim2.new(1, -30, 0, 20)
  textLabel2.TextXAlignment = Enum.TextXAlignment.Left
  textLabel2.Parent = frame

  local textBox = Instance.new("TextBox")
  textBox.PlaceholderText = "Enter Key"
  textBox.Text = ""
  textBox.Font = Enum.Font.Gotham
  textBox.TextSize = 16
  textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
  textBox.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
  textBox.Size = UDim2.new(1, -30, 0, 38)
  textBox.Position = UDim2.new(0, 15, 0, 75)
  textBox.BorderSizePixel = 0
  textBox.ClearTextOnFocus = false
  textBox.Parent = frame

  local uiCorner2 = Instance.new("UICorner")
  uiCorner2.CornerRadius = UDim.new(0, 6)
  uiCorner2.Parent = textBox

  local textLabel3 = Instance.new("TextLabel")
  textLabel3.Text = ""
  textLabel3.Font = Enum.Font.Gotham
  textLabel3.TextSize = 14
  textLabel3.TextColor3 = Color3.fromRGB(255, 75, 75)
  textLabel3.BackgroundTransparency = 1
  textLabel3.Position = UDim2.new(0, 15, 0, 115)
  textLabel3.Size = UDim2.new(1, -30, 0, 20)
  textLabel3.TextXAlignment = Enum.TextXAlignment.Center
  textLabel3.Parent = frame

  local textButton = Instance.new("TextButton")
  textButton.Text = "ENTER"
  textButton.Font = Enum.Font.GothamBold
  textButton.TextSize = 16
  textButton.TextColor3 = Color3.fromRGB(255, 255, 255)
  textButton.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
  textButton.Size = UDim2.new(0.45, 0, 0, 40)
  textButton.Position = UDim2.new(0.05, 0, 0, 140)
  textButton.BorderSizePixel = 0
  textButton.Parent = frame

  Instance.new("UICorner", textButton).CornerRadius = UDim.new(0, 6)

  local textButton2 = Instance.new("TextButton")
  textButton2.Text = "COPY DISCORD LINK"
  textButton2.Font = Enum.Font.GothamBold
  textButton2.TextSize = 16
  textButton2.TextColor3 = Color3.fromRGB(255, 255, 255)
  textButton2.BackgroundColor3 = Color3.fromRGB(52, 152, 219)
  textButton2.Size = UDim2.new(0.45, 0, 0, 40)
  textButton2.Position = UDim2.new(0.5, 10, 0, 140)
  textButton2.BorderSizePixel = 0
  textButton2.Parent = frame

  Instance.new("UICorner", textButton2).CornerRadius = UDim.new(0, 6)

  local function f3(p1, backgroundColor3, backgroundColor32)
    p1.MouseEnter:Connect(function()
      tweenService:Create(p1, TweenInfo.new(0.2), { BackgroundColor3 = backgroundColor3 }):Play()
    end)

    p1.MouseLeave:Connect(function()
      tweenService:Create(p1, TweenInfo.new(0.2), { BackgroundColor3 = backgroundColor32 }):Play()
    end)
  end

  f3(textButton, Color3.fromRGB(39, 174, 96), Color3.fromRGB(46, 204, 113))
  f3(textButton2, Color3.fromRGB(41, 128, 185), Color3.fromRGB(52, 152, 219))

  local v1, position, position2

  frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
      v1 = true
      position = input.Position
      position2 = frame.Position

      input.Changed:Connect(function()
        if input.UserInputState == Enum.UserInputState.End then
          v1 = false
        end
      end)
    end
  end)

  local v2

  frame.InputChanged:Connect(function(input2)
    if input2.UserInputType == Enum.UserInputType.MouseMovement then
      v2 = input2
    end
  end)

  userInputService.InputChanged:Connect(function(input3)
    if input3 == v2 and v1 then
      local v3 = input3.Position - position

      frame.Position = UDim2.new(
        position2.X.Scale, position2.X.Offset + v3.X, position2.Y.Scale,
        position2.Y.Offset + v3.Y
      )
    end
  end)

  local function f4()
    if textBox.Text == "E6ONTOP" then
      hasEnteredNewEmoteKey.Value = true
      newEmotesKeyUI:Destroy()
      f1()
    else
      textBox.Text = ""
      textBox.PlaceholderText = "❌ Invalid Key"
      textBox.PlaceholderColor3 = Color3.fromRGB(255, 75, 75)

      textLabel3.Text = "Incorrect key. Please try again."
    end
  end

  textButton.MouseButton1Click:Connect(f4)

  textBox.FocusLost:Connect(function(p2)
    if p2 then
      f4()
    end
  end)

  textButton2.MouseButton1Click:Connect(function()
    setclipboard("https://discord.gg/euuqeNxw4G")
    textLabel3.Text = "✅ Discord link copied!"
    textLabel3.TextColor3 = Color3.fromRGB(100, 255, 100)
  end)
end

if hasEnteredNewEmoteKey.Value then
  f1()
else
  f2()
end
